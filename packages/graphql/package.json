{
  "name": "@fuel-explorer/graphql",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "author": "Fuel Labs <contact@fuel.sh> (https://fuel.network/)",
  "license": "Apache-2.0",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "typings": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./sdk": "./src/graphql/generated/sdk.ts",
    "./sdkProvider": "./src/graphql/generated/sdk-provider.ts"
  },
  "typesVersions": {
    "*": {
      "sdk": ["./src/graphql/generated/sdk.ts"],
      "sdkProvider": ["./src/graphql/generated/sdk-provider.ts"]
    }
  },
  "scripts": {
    "build:lib": "run-s build:sdk",
    "build:sdk": "tsup",
    "ts:check": "tsc --noEmit",
    "codegen": "run-s codegen:*",
    "codegen:gql-fuelcore": "gqlg --schemaFilePath ./src/graphql/schemas/fuelcore.graphql --destDirPath ./src/graphql/generated/fuelcore --ext graphql --includeCrossReferences --depthLimit 6",
    "codegen:sdk": "gql-gen -r dotenv/config --config codegen.sdk.ts"
  },
  "peerDependencies": {
    "graphql": ">=16.10.0",
    "graphql-request": ">=6.1.0",
    "graphql-tag": ">=2.12.6"
  },
  "dependencies": {
    "dayjs": "1.11.11",
    "dotenv": "16.4.5",
    "drizzle-orm": "^0.31.2",
    "graphql": "16.10.0",
    "lodash": "^4.17.21",
    "npm-run-all": "^4.1.5",
    "shallow-equal-object": "1.1.1",
    "tai64": "^1.0.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@fuels/ts-config": "0.26.0",
    "@graphql-codegen/cli": "^5.0.2",
    "@graphql-codegen/introspection": "^4.0.3",
    "@graphql-codegen/schema-ast": "^4.1.0",
    "@graphql-codegen/typescript": "^4.0.8",
    "@graphql-codegen/typescript-graphql-request": "^6.2.0",
    "@graphql-codegen/typescript-operations": "^4.2.2",
    "@graphql-tools/graphql-file-loader": "8.0.1",
    "@types/fs-extra": "11.0.4",
    "@types/lodash": "4.17.6",
    "@types/node": "^20.14.9",
    "fs-extra": "11.2.0",
    "gql-generator": "2.0.0",
    "graphql": "16.10.0",
    "graphql-codegen-typescript-mock-data": "3.8.0",
    "graphql-config": "5.0.3",
    "graphql-request": "6.1.0",
    "graphql-tag": "^2.12.6",
    "tsup": "8.1.0",
    "tsx": "4.16.0",
    "typescript": "^5.5.2"
  }
}
