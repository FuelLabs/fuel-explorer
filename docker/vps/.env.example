AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-1
S3_BUCKET=fuel-blocks-mainnet-ap-northeast-1
FUEL_PROVIDER=https://mainnet.fuel.network/v1/graphql
INDEX_RETENTION_DAYS=3
INDEX_MAX_BYTES=15000000000
DISK_CACHE_BYTES=5368709120
# Real-heap budget for BlockStore's in-memory LRU (see config.ts's comment on
# MEMORY_CACHE_BYTES for the multiplier math behind this default). Both
# docker-compose.yml and docker-compose.prod.yml hardcode this same value in
# their `environment:` block, which takes precedence over whatever's set
# here -- kept in sync for documentation, not actually read by them.
MEMORY_CACHE_BYTES=50331648
BLOCK_SOURCE=s3
# s3 | rpc  (rpc needs no AWS keys)
RPC_MAX_BLOCKS_PER_SECOND=5

# GHCR image owner for docker-compose.prod.yml, e.g. the GitHub org or user
# that owns the fuel-explorer-vps-explorer / fuel-explorer-vps-api-lite packages.
REGISTRY_OWNER=
# Staking and bridge history. Unset ETH_RPC_URL disables the L1 poller and those routes answer 503.
ETH_RPC_URL=
FUEL_CHAIN=mainnet
COSMOS_REST_URL=https://rest.seq.mainnet.fuel.network
COSMOS_INDEXER_URL=https://index-api.sequencer.mainnet.fuel.network
COSMOS_START_HEIGHT=
