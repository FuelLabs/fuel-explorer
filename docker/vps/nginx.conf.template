# Default keys on the TCP peer address. $xff_first (first X-Forwarded-For hop)
# is only safe behind a proxy that rewrites the header itself, as Railway's edge does.
map $http_x_forwarded_for $xff_first {
    default $binary_remote_addr;
    "~^([^,\s]+)" $1;
}

# Marks whether $xff_first is itself a Cloudflare edge address (source var first, geo var second, per nginx geo docs).
geo $xff_first $via_cloudflare {
    default 0;
    include /etc/nginx/cloudflare-ips.conf;
}

# Behind Cloudflare, key on CF-Connecting-IP instead of the (Cloudflare) first XFF hop; a direct client can't
# forge this because Railway's edge rewrites XFF, so $xff_first can only be Cloudflare's address when Cloudflare set it.
map "$via_cloudflare:$http_cf_connecting_ip" $client_ip {
    default $xff_first;
    "~^1:(?<ip>.+)$" $ip;
}

# One zone, keyed by client IP, 10 MB capping each at 20 requests/sec; /api/
# below allows a 40-request burst before it starts rejecting (nodelay: burst
# requests are served immediately, not queued/delayed).
limit_req_zone ${RATE_LIMIT_KEY} zone=api:10m rate=20r/s;
# 1 MB keys zone (~enough for the single /api/charts key), 10 MB max cached
# response bodies, evicted after 5 min unused; backs the 60s edge cache below.
log_format proxied '$remote_addr xff="$http_x_forwarded_for" [$time_local] "$request" $status $body_bytes_sent $request_time';
proxy_cache_path /var/cache/nginx/charts levels=1 keys_zone=charts:1m max_size=10m inactive=5m;

# Per-route unfurl tags. Keep in sync with packages/app-explorer/src/systems/Core/pageMeta.ts.
# First match wins. /blocks precedes /block; bridge history precedes /bridge.
# Case-sensitive, with a path boundary, like the RULES in pageMeta.ts: /bridgefoo is not /bridge.
# Keys are matched against $request_uri, so the boundary also accepts a query string.
map $request_uri $page_title {
    default "Fuel Explorer";
    "~^/bridge/history(?:[/?]|$)" "Bridge history · Fuel Explorer";
    "~^/bridge(?:[/?]|$)" "Bridge · Fuel Explorer";
    "~^/staking/on-ethereum(?:[/?]|$)" "Stake on Ethereum · Fuel Explorer";
    "~^/staking(?:[/?]|$)" "Stake · Fuel Explorer";
    "~^/ecosystem(?:[/?]|$)" "Ecosystem · Fuel Explorer";
    "~^/blocks(?:[/?]|$)" "Blocks · Fuel Explorer";
    "~^/block/([0-9A-Za-z]+)(?:[/?]|$)" "Block $1 · Fuel Explorer";
    "~^/tx/([0-9A-Za-z]+)(?:[/?]|$)" "Transaction · Fuel Explorer";
    "~^/account/([0-9A-Za-z]+)(?:[/?]|$)" "Account · Fuel Explorer";
    "~^/contract/([0-9A-Za-z]+)(?:[/?]|$)" "Contract · Fuel Explorer";
    "~^/upgrade(?:[/?]|$)" "Token manager · Fuel Explorer";
}

map $request_uri $page_description {
    default "Blocks, transactions and live network stats for Fuel Ignition.";
    "~^/bridge/history(?:[/?]|$)" "Pending and completed transfers between Ethereum and Fuel.";
    "~^/bridge(?:[/?]|$)" "Move assets between Ethereum and Fuel Ignition.";
    "~^/staking/on-ethereum(?:[/?]|$)" "Stake FUEL on Ethereum and track positions, validators and transactions.";
    "~^/staking(?:[/?]|$)" "Delegate FUEL to validators, or liquid stake through The Rig.";
    "~^/ecosystem(?:[/?]|$)" "Apps, wallets and infrastructure built on Fuel.";
    "~^/blocks(?:[/?]|$)" "Recent blocks on Fuel Ignition.";
    "~^/block/([0-9A-Za-z]+)(?:[/?]|$)" "Block $1 on Fuel Ignition.";
    "~^/tx/([0-9A-Za-z]+)(?:[/?]|$)" "A transaction on Fuel Ignition.";
    "~^/account/([0-9A-Za-z]+)(?:[/?]|$)" "Assets, transactions and NFTs for a Fuel account.";
    "~^/contract/([0-9A-Za-z]+)(?:[/?]|$)" "Assets, code and transactions for a Fuel contract.";
    "~^/upgrade(?:[/?]|$)" "Contributor grants and Fuel token release schedules.";
}

map $http_x_forwarded_proto $forwarded_proto {
    default $scheme;
    https https;
    http http;
}

# The request path goes into an HTML attribute; anything that could close it
# falls back to the site root. nginx does not reject ", <, or > in the request
# Host, so that header is not written into the page. The share URL host is
# $server_name, the public hostname substituted from RAILWAY_PUBLIC_DOMAIN.
map $request_uri $page_path {
    default "/";
    '~^[^"<>&\s]*$' $request_uri;
}

server {
    listen 80;
    listen [::]:80;
    access_log /var/log/nginx/access.log proxied;
    server_name ${RAILWAY_PUBLIC_DOMAIN};
    root /usr/share/nginx/html;
    index index.html;

    # Railway terminates TLS, so an absolute redirect would point at http://.
    absolute_redirect off;

    # nginx defaults a rate-limited request to 503, which on this box is
    # indistinguishable from the API being down: the uptime probe hits
    # /api/health, so a legitimate burst would read as an outage and page
    # someone. 429 states the actual reason, and clients treat it as "slow
    # down" rather than "retry the broken server".
    limit_req_status 429;

    # CSP is report-only until every wallet and RPC host is confirmed.
    # A location with its own add_header loses these, so each such location
    # repeats them.
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options DENY always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://api.coingecko.com https://verified-assets.fuel.network https://raw.githubusercontent.com https://*.fuel.network https://*.walletconnect.com wss://*.walletconnect.com https://*.walletconnect.org wss://*.walletconnect.org https://*.g.alchemy.com https://*.infura.io https://cloudflare-eth.com https://eth.llamarpc.com https://*.rpc.thirdweb.com https://*.coinbase.com; frame-src https://*.walletconnect.com https://*.walletconnect.org; frame-ancestors 'none'" always;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;
    gzip_min_length 1024;

    # Hashed Vite assets never change: cache for a year.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header X-Frame-Options DENY always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://api.coingecko.com https://verified-assets.fuel.network https://raw.githubusercontent.com https://*.fuel.network https://*.walletconnect.com wss://*.walletconnect.com https://*.walletconnect.org wss://*.walletconnect.org https://*.g.alchemy.com https://*.infura.io https://cloudflare-eth.com https://eth.llamarpc.com https://*.rpc.thirdweb.com https://*.coinbase.com; frame-src https://*.walletconnect.com https://*.walletconnect.org; frame-ancestors 'none'" always;
        try_files $uri =404;
    }

    # Exact match takes priority over the /api/ prefix block below, so
    # /api/charts is cached at the edge (200s only) instead of proxied on
    # every request; a stale cached body is served while revalidating on an
    # upstream error/timeout instead of surfacing that error to the client.
    location = /api/charts {
        limit_req zone=api burst=40 nodelay;
        resolver ${NGINX_RESOLVER} valid=10s ipv6=on;
        set $api_upstream http://${API_UPSTREAM};
        proxy_cache charts;
        proxy_cache_valid 200 60s;
        proxy_ignore_headers Cache-Control Expires;
        proxy_cache_use_stale updating error timeout;
        add_header X-Cache $upstream_cache_status;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header X-Frame-Options DENY always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://api.coingecko.com https://verified-assets.fuel.network https://raw.githubusercontent.com https://*.fuel.network https://*.walletconnect.com wss://*.walletconnect.com https://*.walletconnect.org wss://*.walletconnect.org https://*.g.alchemy.com https://*.infura.io https://cloudflare-eth.com https://eth.llamarpc.com https://*.rpc.thirdweb.com https://*.coinbase.com; frame-src https://*.walletconnect.com https://*.walletconnect.org; frame-ancestors 'none'" always;
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_read_timeout 30s;
    }

    # 5s matches the origin's DataCache TTL for the dashboard.
    location = /api/dashboard {
        limit_req zone=api burst=40 nodelay;
        resolver ${NGINX_RESOLVER} valid=10s ipv6=on;
        set $api_upstream http://${API_UPSTREAM};
        proxy_cache charts;
        proxy_cache_valid 200 5s;
        proxy_ignore_headers Cache-Control Expires;
        proxy_cache_use_stale updating error timeout;
        add_header X-Cache $upstream_cache_status;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header X-Frame-Options DENY always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://api.coingecko.com https://verified-assets.fuel.network https://raw.githubusercontent.com https://*.fuel.network https://*.walletconnect.com wss://*.walletconnect.com https://*.walletconnect.org wss://*.walletconnect.org https://*.g.alchemy.com https://*.infura.io https://cloudflare-eth.com https://eth.llamarpc.com https://*.rpc.thirdweb.com https://*.coinbase.com; frame-src https://*.walletconnect.com https://*.walletconnect.org; frame-ancestors 'none'" always;
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_read_timeout 30s;
    }

    location /api/ {
        limit_req zone=api burst=40 nodelay;
        # Resolved at request time (not at nginx startup) so Railway's private
        # DNS for api.railway.internal keeps working across service restarts.
        resolver ${NGINX_RESOLVER} valid=10s ipv6=on;
        set $api_upstream http://${API_UPSTREAM};
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_read_timeout 30s;
    }

    # SPA fallback, same as the Vercel rewrite in packages/app-explorer/vercel.json.
    location / {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header X-Frame-Options DENY always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://api.coingecko.com https://verified-assets.fuel.network https://raw.githubusercontent.com https://*.fuel.network https://*.walletconnect.com wss://*.walletconnect.com https://*.walletconnect.org wss://*.walletconnect.org https://*.g.alchemy.com https://*.infura.io https://cloudflare-eth.com https://eth.llamarpc.com https://*.rpc.thirdweb.com https://*.coinbase.com; frame-src https://*.walletconnect.com https://*.walletconnect.org; frame-ancestors 'none'" always;
        # No $uri/ entry: a path that shares its name with a directory in the
        # build output, such as /assets, must fall through to the app instead of
        # redirecting into that directory.
        set $page_url "$forwarded_proto://$server_name$page_path";
        sub_filter_once off;
        sub_filter_types text/html;
        sub_filter '__PAGE_TITLE__' $page_title;
        sub_filter '__PAGE_DESCRIPTION__' $page_description;
        sub_filter '__PAGE_URL__' $page_url;
        try_files $uri /index.html;
    }
}
