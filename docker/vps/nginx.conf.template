# Default keys on the TCP peer address; $xff_last (the last, nearest-proxy
# hop of X-Forwarded-For) is only safe behind a proxy that appends the client address.
map $http_x_forwarded_for $xff_last {
    default $binary_remote_addr;
    "~^(?:.*,\s*)?([^,\s]+)\s*$" $1;
}

# One zone, keyed by client IP, 10 MB capping each at 20 requests/sec; /api/
# below allows a 40-request burst before it starts rejecting (nodelay: burst
# requests are served immediately, not queued/delayed).
limit_req_zone ${RATE_LIMIT_KEY} zone=api:10m rate=20r/s;
# 1 MB keys zone (~enough for the single /api/charts key), 10 MB max cached
# response bodies, evicted after 5 min unused; backs the 60s edge cache below.
proxy_cache_path /var/cache/nginx/charts levels=1 keys_zone=charts:1m max_size=10m inactive=5m;

server {
    listen 80;
    listen [::]:80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;
    gzip_min_length 1024;

    # Hashed Vite assets never change: cache for a year.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Exact match takes priority over the /api/ prefix block below, so
    # /api/charts is cached at the edge (200s only) instead of proxied on
    # every request; a stale cached body is served while revalidating on an
    # upstream error/timeout instead of surfacing that error to the client.
    location = /api/charts {
        limit_req zone=api burst=40 nodelay;
        resolver ${NGINX_RESOLVER} valid=10s ipv6=on;
        set $api_upstream http://${API_UPSTREAM};
        proxy_cache charts;
        proxy_cache_valid 200 60s;
        proxy_ignore_headers Cache-Control Expires;
        proxy_cache_use_stale updating error timeout;
        add_header X-Cache $upstream_cache_status;
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_read_timeout 30s;
    }

    location /api/ {
        limit_req zone=api burst=40 nodelay;
        # Resolved at request time (not at nginx startup) so Railway's private
        # DNS for api.railway.internal keeps working across service restarts.
        resolver ${NGINX_RESOLVER} valid=10s ipv6=on;
        set $api_upstream http://${API_UPSTREAM};
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_read_timeout 30s;
    }

    # SPA fallback, same as the Vercel rewrite in packages/app-explorer/vercel.json.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
